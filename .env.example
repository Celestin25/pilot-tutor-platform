# Turso database (libSQL). Leave unset locally to use file:local.db
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=
# Claude API key (server-side only)
ANTHROPIC_API_KEY=
# Researcher dashboard password + cookie signing secret (long random string)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional: OpenAI-compatible provider for hosted Llama
LLM_BASE_URL=
LLM_API_KEY=
# Testing only: 1 = simulated tutor replies
LLM_MOCK=
